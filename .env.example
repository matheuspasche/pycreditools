# Copie para .env e preencha. O .env NAO e versionado (segredos) e o loop NUNCA o toca,
# entao voce pode edita-lo com o loop rodando. As mudancas valem na proxima recriacao:
#   docker compose --profile v06 up -d --force-recreate ralph_v06

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
# Token OAuth da assinatura. Gere com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Token do GitHub. Pegue com: gh auth token
GH_TOKEN=
# Topico ntfy para as notificacoes no celular. E o unico segredo do canal: quem sabe o
# topico le as mensagens. Assine a mesma string no app ntfy (servidor ntfy.sh).
NTFY_TOPIC=

# ---------------------------------------------------------------------------
# Janela de trabalho — o loop so trabalha aqui dentro
# ---------------------------------------------------------------------------
# A janela e checada ENTRE turnos, nunca no meio de um: um turno interrompido perderia o
# que ainda nao virou commit. Deixe START igual a END (ou ambos vazios) para rodar 24h.
WORK_WINDOW_START=22:00
WORK_WINDOW_END=08:00
WORK_WINDOW_TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Teto de uso — ISTO NAO E DINHEIRO
# ---------------------------------------------------------------------------
# A conta roda por assinatura: nada e cobrado, o que o loop gasta e COTA. Mas a unica
# grandeza de consumo observavel localmente e o `total_cost_usd` que o CLI devolve por
# turno (o preco daqueles tokens SE fossem comprados na API). E um medidor, nao uma
# fatura, e serve de freio porque sobe junto com a cota.
# Calibre comparando o acumulado de .ralph/usage.tsv com o percentual que o `/usage`
# mostra numa sessao interativa. Referencia: um turno de implementacao marcou 11,10.
WEEKLY_BUDGET_USD=150
BUDGET_STOP_PCT=80

# ---------------------------------------------------------------------------
# Notificacoes — nada aqui e urgente
# ---------------------------------------------------------------------------
# "urgent" no ntfy toca como alarme e ja acordou o dono as 4h. Teto: "default".
# Escala: min | low | default | high | urgent
NTFY_PRIORITY_ALERT=default
NTFY_PRIORITY_INFO=low
# Sinal de vida durante espera longa (cota, janela fechada, teto). Do celular, silencio e
# indistinguivel de morte — foi assim que 8h de loop travado passaram despercebidas.
HEARTBEAT_SECONDS=7200

# ---------------------------------------------------------------------------
# Ritmo e limites do par
# ---------------------------------------------------------------------------
# MAX_ROUNDS e o teto que realmente limita o gasto por ticket. Medido no #157: uma rodada
# de auditoria marca 3,1 a 5,5 no medidor e uma de implementacao ~0,7 — com 8 rodadas um
# ticket so podia comer mais de um TERCO do teto semanal. Se o par nao convergiu em 5, o
# que falta nao e mais uma rodada, e uma decisao sua.
MAX_ROUNDS=5
# Acima disto a sessao daquele papel comeca fresca na proxima rodada, com o briefing
# inteiro. Rotacionar e mais barato que compactar; compactar e lossy e se paga duas vezes.
# Cap POR PAPEL: o auditor le o diff inteiro e cada arquivo alterado por completo, entao
# ele fecha muito mais alto por oficio, nao por descuido (medido no #157: 173k contra 40k
# do implementador). Um cap so media os dois com a mesma regua e rotacionava o auditor
# toda rodada, jogando fora a memoria dos proprios achados.
CONTEXT_CAP_IMPL=150000
CONTEXT_CAP_AUDIT=250000
# Watchdog: um turno pendurado nao morre sozinho e o `restart: on-failure` nao o alcanca.
TURN_TIMEOUT_SECONDS=7200
# Tickets a ignorar na fila (numeros separados por espaco). Ver docker-compose.yml.
# SKIP_ISSUES=160
